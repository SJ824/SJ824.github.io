{% assign award_years = site.data.awards | group_by: 'year' | sort: 'name' | reverse %}
{% assign year_heading = include.year_heading | default: 'h3' %}
{% assign award_heading = include.award_heading | default: 'h4' %}
{% assign detail_heading = award_heading | remove: 'h' | plus: 1 | prepend: 'h' %}

<div class="awards">
  {% for year in award_years %}
    <section class="awards-year-group" aria-labelledby="awards-year-{{ year.name }}">
      <{{ year_heading }} class="awards-year" id="awards-year-{{ year.name }}">{{ year.name }}</{{ year_heading }}>
      <ul class="awards-list" role="list">
        {% for award in year.items %}
          <li class="award-entry">
            <div class="award-heading">
              {% if award.distinction %}
                <span class="award-distinction">{{ award.distinction }}</span>
              {% endif %}
              <{{ award_heading }} class="award-title">
                {% if award.distinction %}
                  <span class="sr-only">{{ award.distinction }}: </span>
                {% endif %}
                {{ award.title }}
              </{{ award_heading }}>
              {% if award.prize %}
                <span class="award-prize"><span class="sr-only">Award amount: </span>{{ award.prize }}</span>
              {% endif %}
            </div>
            {% if award.organization or award.context %}
              <p class="award-meta">
                {% if award.organization %}
                  <span>{{ award.organization }}</span>
                {% endif %}
                {% if award.context %}
                  <span>{{ award.context }}</span>
                {% endif %}
              </p>
            {% endif %}
            {% if award.description %}
              <p class="award-description">{{ award.description }}</p>
            {% endif %}
            {% if award.privilege %}
              <p class="award-privilege"><span class="award-detail-label">Special privilege:</span> {{ award.privilege }}</p>
            {% endif %}
            {% if award.project %}
              <p class="award-description"><span class="award-detail-label">{{ award.project_label | default: 'Project' }}:</span> {{ award.project }}</p>
            {% endif %}
            {% if award.links or award.project_details %}
              <div class="award-links">
                {% if award.links.size > 1 %}
                  <details class="award-news" name="award-news">
                    <summary class="award-news-toggle">
                      News
                      <span class="award-news-chevron" aria-hidden="true"></span>
                    </summary>
                    <ul class="award-news-sources" aria-label="News articles">
                      {% for link in award.links %}
                        <li>
                          <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">
                            {{ link.label }}
                            <span class="award-link-arrow" aria-hidden="true">↗</span>
                            <span class="sr-only"> (opens in a new tab)</span>
                          </a>
                        </li>
                      {% endfor %}
                    </ul>
                  </details>
                {% elsif award.links.size == 1 %}
                  <a class="award-news-toggle" href="{{ award.links.first.url }}" target="_blank" rel="noopener noreferrer">
                    News
                    <span class="award-link-arrow" aria-hidden="true">↗</span>
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                {% endif %}
                {% if award.project_details %}
                  {% include award_project.liquid project=award.project_details heading=detail_heading %}
                {% endif %}
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endfor %}
</div>
